# Copy this file to .env and fill in real values. The .env file is
# git-ignored; never commit credentials.
#
# These variables are only used by the reverse-proxy overlay
# (compose.proxy.yaml); plain `docker compose up` ignores them.

# Hostname served by Caddy. "localhost" uses Caddy's internal CA
# (self-signed, for local/LAN testing); a real public hostname gets
# automatic HTTPS certificates via ACME.
PPM_PROXY_HOST=localhost

# Username for HTTP basic authentication.
PPM_PROXY_USER=change-me

# Bcrypt hash of the password (never the plain password). Generate it with:
#   docker run --rm caddy:2.10 caddy hash-password --plaintext 'your-password'
# Wrap the hash in single quotes. In this .env file, Docker Compose does not
# interpolate inside single quotes, so the $ characters survive unchanged;
# an unquoted hash would be mangled ($2a$14$... is read as variable lookups).
PPM_PROXY_PASSWORD_HASH='change-me'
